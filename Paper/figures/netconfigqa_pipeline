// NetConfigQA Pipeline
digraph {
	rankdir=LR
	node [fontname="Malgun Gothic" shape=box style="rounded,filled"]
	subgraph cluster_0 {
		color=grey label="Phase 1: Network Environment & Data Collection" style=dashed
		fontname="Malgun Gothic"
		PnetLab [label="PnetLab Environment
(10 Nodes: Leaf/Spine/PE)" fillcolor=lightblue]
		NSO [label="Cisco NSO
(Orchestrator)" fillcolor=lightblue]
		Scripts [label="Collection Scripts
(SSH Enable / Export)" fillcolor=lightyellow shape=note]
		PnetLab -> NSO [label=" Sync"]
		NSO -> Scripts [label=" Config Export"]
	}
	subgraph cluster_1 {
		color=grey label="Phase 2: Batfish Analysis Engine" style=dashed
		fontname="Malgun Gothic"
		RawConfig [label="Raw Config Files
(.cfg / .xml)" fillcolor=white shape=folder]
		Batfish [label="Batfish Engine
(Parsing & Modeling)" fillcolor=lightgreen]
		StructData [label="Structured Data
(L1 Topology, Routing Table,
ACL, VRF Info)" fillcolor=white style=dashed]
		RawConfig -> Batfish
		Batfish -> StructData
	}
	subgraph cluster_2 {
		color=black label="Phase 3: Hybrid QA Generation (builder_core.py)" style=bold
		fontname="Malgun Gothic"
		Templates [label="126 Question Templates
(17 Categories)" fillcolor=lightyellow shape=parallelogram]
		Generator [label="QA Generator Core" fillcolor=orange]
		Decision [label="Difficulty Level?" fillcolor=white shape=diamond]
		Static [label="L1-L3 (Static)
Fact Extraction
(Regex/Table Lookup)" fillcolor=lightcyan]
		Sim [label="L4-L5 (Dynamic)
Network Simulation
(Traceroute / Failure)" fillcolor=lightcyan]
		Templates -> Generator
		StructData -> Generator [lhead=cluster_2]
		Generator -> Decision
		Decision -> Static [label=" Simple Fact"]
		Decision -> Sim [label=" Inference"]
	}
	subgraph cluster_3 {
		color=grey label="Phase 4: Dataset" style=dashed
		fontname="Malgun Gothic"
		Dataset [label="NetConfigQA2 Dataset
(Question - Answer - Metadata)" fillcolor=gold shape=cylinder]
	}
	Scripts -> RawConfig [label=" 3.Export"]
	Static -> Dataset
	Sim -> Dataset
}
