<mxfile><diagram name="Page-1" id="page-1"><mxGraphModel dx="1373" dy="931" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="583" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" parent="1" style="text;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=22;fontColor=#1A237E;" value="NetConfigQA3: 대규모 네트워크 지능형 에이전트 시스템 마스터 설계도" vertex="1"><mxGeometry height="40" width="1120" x="40" y="10" as="geometry"/></mxCell><mxCell id="3" parent="1" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#424242;startSize=25;fontStyle=1;" value="1. 문제 정의 및 진화 전략" vertex="1"><mxGeometry height="230" width="300" x="40" y="70" as="geometry"/></mxCell><mxCell id="4" parent="3" style="text;whiteSpace=wrap;html=1;fontSize=11;spacingLeft=5;" value="&lt;b&gt;[QA2의 한계: 컨텍스트 폭발]&lt;/b&gt;&lt;br/&gt;● 모든 Facts를 프롬프트에 주입 (N&gt;100)&lt;br/&gt;  → 토큰 한계 초과 및 정확도 급락&lt;br/&gt;● 32개 API 노출 → 도구 선택 혼란 발생&lt;br/&gt;&lt;br/&gt;&lt;b&gt;[QA3의 해결: 질의 가능 메모리]&lt;/b&gt;&lt;br/&gt;● 프롬프트 주입 → 필요한 시점에 질의&lt;br/&gt;● &lt;b&gt;Evidence Pack&lt;/b&gt; (선택적 증거 수집)&lt;br/&gt;  - 로그 30개 / 메트릭 20개 / 사실 40개 상한" vertex="1"><mxGeometry height="185" width="280" x="10" y="35" as="geometry"/></mxCell><mxCell id="5" parent="1" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#7B1FA2;startSize=25;fontStyle=1;" value="2. 핵심 설계 원칙" vertex="1"><mxGeometry height="255" width="300" x="40" y="315" as="geometry"/></mxCell><mxCell id="6" parent="5" style="text;whiteSpace=wrap;html=1;fontSize=11;spacingLeft=5;" value="① &lt;b&gt;지도 기반 탐색&lt;/b&gt;&lt;br/&gt; - Lv 1: 네트워크 지도 (구조 요약)&lt;br/&gt; - Lv 2: 증거팩 (질문 관련 상세)&lt;br/&gt;② &lt;b&gt;데이터 저장소 분리&lt;/b&gt;&lt;br/&gt; - Static Facts DB vs Dynamic Telemetry&lt;br/&gt;③ &lt;b&gt;도구 표면적 최소화&lt;/b&gt;&lt;br/&gt; - 5~8개 메가툴(Mega-Tools) 인터페이스&lt;br/&gt;④ &lt;b&gt;멀티에이전트 협력&lt;/b&gt;&lt;br/&gt; - Reasoner(추론) &amp; Retriever(수집) 분리" vertex="1"><mxGeometry height="210" width="280" x="10" y="35" as="geometry"/></mxCell><mxCell id="7" parent="1" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F0F7FF;strokeColor=#005BB7;startSize=25;fontStyle=1;" value="3. 4-Layer 시스템 아키텍처" vertex="1"><mxGeometry height="500" width="480" x="360" y="70" as="geometry"/></mxCell><mxCell id="8" parent="7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#0288D1;fontStyle=1;" value="Layer 1: Agent Layer (추론 &amp; 수집 분리)&lt;br/&gt;[Reasoner: 판단/검증] ↔ [Retriever: 수집/가공]" vertex="1"><mxGeometry height="60" width="440" x="20" y="40" as="geometry"/></mxCell><mxCell id="9" parent="7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;fontStyle=1;" value="Layer 2: HITL Layer (안전 승인 관문)&lt;br/&gt;[Approval Gate] [10단계 런북] [실시간 알림]" vertex="1"><mxGeometry height="60" width="440" x="20" y="115" as="geometry"/></mxCell><mxCell id="10" parent="7" style="swimlane;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;startSize=23;fontSize=11;" value="Layer 3: Query Tools Layer (통합 인터페이스)" vertex="1"><mxGeometry height="150" width="440" x="20" y="190" as="geometry"/></mxCell><mxCell id="11" parent="10" style="whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;" value="&lt;b&gt;facts.query()&lt;/b&gt;&lt;br/&gt;정적 설정/구조" vertex="1"><mxGeometry height="50" width="130" x="10" y="30" as="geometry"/></mxCell><mxCell id="12" parent="10" style="whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;" value="&lt;b&gt;batfish.query/diff()&lt;/b&gt;&lt;br/&gt;시뮬레이션 및 비교" vertex="1"><mxGeometry height="50" width="140" x="150" y="30" as="geometry"/></mxCell><mxCell id="13" parent="10" style="whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;" value="&lt;b&gt;nso.get/txn()&lt;/b&gt;&lt;br/&gt;상태 조회 및 설정(승인)" vertex="1"><mxGeometry height="50" width="130" x="300" y="30" as="geometry"/></mxCell><mxCell id="14" parent="10" style="whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;" value="&lt;b&gt;logs.query() / metrics.query()&lt;/b&gt;&lt;br/&gt;동적 관측 데이터 (이벤트, 메트릭 윈도우)" vertex="1"><mxGeometry height="40" width="420" x="10" y="90" as="geometry"/></mxCell><mxCell id="15" parent="7" style="swimlane;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#FBC02D;startSize=23;fontSize=11;" value="Layer 4: Data Layer (물리적 저장소 분리)" vertex="1"><mxGeometry height="125" width="440" x="20" y="355" as="geometry"/></mxCell><mxCell id="16" parent="15" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=10;" value="&lt;b&gt;Static Facts DB&lt;/b&gt;&lt;br/&gt;CFG 추출 사실&lt;br/&gt;(VRF, BGP, ACL 등)" vertex="1"><mxGeometry height="75" width="150" x="40" y="35" as="geometry"/></mxCell><mxCell id="17" parent="15" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=10;" value="&lt;b&gt;Dynamic Telemetry&lt;/b&gt;&lt;br/&gt;로그/메트릭/플로우&lt;br/&gt;실시간 가변 데이터" vertex="1"><mxGeometry height="75" width="150" x="250" y="35" as="geometry"/></mxCell><mxCell id="18" parent="1" style="swimlane;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;startSize=25;fontStyle=1;" value="4. 운영 안전: 10단계 런북" vertex="1"><mxGeometry height="230" width="300" x="860" y="70" as="geometry"/></mxCell><mxCell id="19" parent="18" style="text;whiteSpace=wrap;html=1;fontSize=11;spacingLeft=5;" value="● 런북 흐름: 목표→증거v1→[✓체크1]→가설&lt;br/&gt;   →[✓체크2]→변경안→DryRun→[✓체크3]&lt;br/&gt;   →Diff→최종제안→[⚠️승인]→Commit→검증&lt;br/&gt;&lt;br/&gt;● 리스크 기반 작업 분류:&lt;br/&gt; - &lt;b&gt;High&lt;/b&gt;: commit, rollback (승인 필수)&lt;br/&gt; - &lt;b&gt;Critical&lt;/b&gt;: any-any permit (절대 거부)&lt;br/&gt; - &lt;b&gt;Low&lt;/b&gt;: 단순 질의 및 조회 (자동화)&lt;br/&gt;● &lt;b&gt;Rollback&lt;/b&gt;: NSO ID 기반 즉시 복구 시스템" vertex="1"><mxGeometry height="185" width="280" x="10" y="35" as="geometry"/></mxCell><mxCell id="20" parent="1" style="swimlane;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00695C;startSize=25;fontStyle=1;" value="5. 실험 설계 및 핵심 주장" vertex="1"><mxGeometry height="255" width="300" x="860" y="315" as="geometry"/></mxCell><mxCell id="21" parent="20" style="text;whiteSpace=wrap;html=1;fontSize=11;spacingLeft=5;" value="&lt;b&gt;[실험 3축 프레임워크]&lt;/b&gt;&lt;br/&gt;● A: 정적 QA (NetBench, TeleQnA)&lt;br/&gt;● B: 동적 분석 (NIKA Arena - 트러블슈팅)&lt;br/&gt;● C: 운영 실천성 (Task-Spec 기반 검증)&lt;br/&gt;&lt;br/&gt;&lt;b&gt;[핵심 주장 (SIGCOMM)]&lt;/b&gt;&lt;br/&gt;● 주장 A: Verifier+승인 게이트 결합 시에만&lt;br/&gt;  안전성과 효율성을 동시에 달성&lt;br/&gt;● 주장 B: Evidence Pack 통제 시 적은 비용&lt;br/&gt;  (토큰)으로 고성능 트러블슈팅 가능" vertex="1"><mxGeometry height="210" width="280" x="10" y="35" as="geometry"/></mxCell><mxCell id="22" parent="1" style="text;whiteSpace=wrap;html=1;align=center;fontSize=16;fontColor=#D32F2F;fontStyle=1;" value="&quot;같은 성능을 더 싸게 (Retriever+Cache), 같은 비용에서 더 안전하게 (Verifier+Gate)&quot;" vertex="1"><mxGeometry height="30" width="1120" x="40" y="585" as="geometry"/></mxCell><mxCell id="23" edge="1" parent="1" source="3" style="edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;entryX=0;entryY=0.5;html=1;endArrow=classic;strokeColor=#666666;dashed=1;" target="7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="24" edge="1" parent="1" source="7" style="edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;entryX=0;entryY=0.5;html=1;endArrow=classic;strokeColor=#666666;dashed=1;" target="18"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>