{# pe_router.j2 #}
!
! Config Generated by GIA Config Generator
! Topology: {{ topology.description }}
! Role: Provider Edge (PE) Router
!
version 15.7
service timestamps debug datetime msec
service timestamps log datetime msec
service password-encryption
!
hostname {{ node.name }}
!
boot-start-marker
boot-end-marker
!
!
{% for vrf_name in node.vrfs %}
{% set vrf = topology.vrfs[vrf_name] %}
vrf definition {{ vrf_name }}
 rd {{ vrf.rd }}
{% for rt in vrf.rt_export %}
 route-target export {{ rt }}
{% endfor %}
{% for rt in vrf.rt_import %}
 route-target import {{ rt }}
{% endfor %}
 !
 address-family ipv4
 exit-address-family
!
{% endfor %}
!
!
aaa new-model
aaa authentication login default local
!
mmi polling-interval 60
no mmi auto-configure
no mmi pvc
mmi snmp-timeout 180
!
!
no ip domain lookup
ip domain name ncn.go.kr
ip cef
no ipv6 cef
!
multilink bundle-name authenticated
mpls label protocol ldp
!
!
username admin privilege 15 secret 5 $1$1TT7$6NEugkkWBy.AzeNfZi61A1
!
redundancy
!
{% if node.qos is defined %}
{% for cm in node.qos.class_maps %}
class-map match-all {{ cm.name }}
 match {{ cm.match }}
!
{% endfor %}
{% for pm in node.qos.policy_maps %}
policy-map {{ pm.name }}
{% for cls in pm.classes %}
 class {{ cls.class }}
  bandwidth percent {{ cls.bandwidth_percent }}
{% endfor %}
!
{% endfor %}
{% endif %}
{% if node.netflow is defined %}
flow record {{ node.netflow.flow_record }}
 match ipv4 source address
 match ipv4 destination address
 match transport source-port
 match transport destination-port
 collect counter bytes long
 collect counter packets long
!
flow exporter {{ node.netflow.flow_exporter }}
 destination {{ node.netflow.exporter_dest }}
 transport udp 9996
!
flow monitor {{ node.netflow.flow_monitor }}
 record {{ node.netflow.flow_record }}
 exporter {{ node.netflow.flow_exporter }}
!
{% endif %}
!
interface Loopback0
 ip address {{ node.loopback | ip_address }} 255.255.255.255
!
{% for intf in node.interfaces %}
interface {{ intf.name }}
{% if intf.vrf is defined %}
 vrf forwarding {{ intf.vrf }}
{% endif %}
{% if intf.ip is defined %}
 ip address {{ intf.ip | ip_address }} {{ intf.ip | netmask }}
{% endif %}
{% if intf.description is defined %}
 description {{ intf.description }}
{% endif %}
 duplex auto
 speed auto
 media-type rj45
{% if intf.mpls|default(false) %}
 mpls ip
{% endif %}
{% if intf.ospf_cost is defined %}
 ip ospf cost {{ intf.ospf_cost }}
{% endif %}
{% if intf.xconnect is defined %}
 xconnect {{ intf.xconnect.peer_ip }} {{ intf.xconnect.pw_id }} encapsulation mpls
{% endif %}
{% if intf.hsrp is defined %}
 standby {{ intf.hsrp.group }} ip {{ intf.hsrp.vip }}
 standby {{ intf.hsrp.group }} priority {{ intf.hsrp.priority }}
 standby {{ intf.hsrp.group }} preempt
{% endif %}
{% if intf.service_policy_out is defined %}
 service-policy output {{ intf.service_policy_out }}
{% endif %}
{% if intf.flow_monitor is defined %}
 ip flow monitor {{ intf.flow_monitor }} input
{% endif %}
!
{% endfor %}
!
! Management Interface (OOB)
interface GigabitEthernet0/{{ topology.management_intf_slot | default(7) }}
 ip address {{ node.management_ip | ip_address }} {{ node.management_ip | netmask }}
 duplex auto
 speed auto
 media-type rj45
!
router ospf {{ topology.routing.ospf.process_id }}
 router-id {{ node.loopback | ip_address }}
{% if topology.routing.ospf.networks == 'auto' %}
 ! Auto-generated OSPF networks for Core Interfaces
 network {{ node.loopback | ip_address }} 0.0.0.0 area {{ node.ospf_area | default(topology.routing.ospf.area) }}
 {% for intf in node.interfaces %}
  {% if intf.mpls|default(false) %}
 network {{ intf.ip | network_address }} {{ intf.ip | wildcard_mask }} area {{ intf.ospf_area | default(node.ospf_area | default(topology.routing.ospf.area)) }}
  {% endif %}
 {% endfor %}
{% endif %}
!
router bgp {{ node.local_as | default(topology.as_number) }}
 bgp log-neighbor-changes
{% for neighbor in node.bgp_neighbors %}
 neighbor {{ neighbor.ip }} remote-as {{ neighbor.as }}
 neighbor {{ neighbor.ip }} update-source Loopback0
{% endfor %}
 !
 address-family vpnv4
{% for neighbor in node.bgp_neighbors %}
  neighbor {{ neighbor.ip }} activate
  neighbor {{ neighbor.ip }} send-community both
{% endfor %}
 exit-address-family
 !
{% for vrf_name in node.vrfs %}
 address-family ipv4 vrf {{ vrf_name }}
  redistribute connected
  redistribute static
 exit-address-family
 !
{% endfor %}
!
ip forward-protocol nd
!
no ip http server
no ip http secure-server
!
! NTP Configuration
ntp server {{ topology.management_gateway }}
!
! Syslog Configuration
logging host {{ topology.management_gateway }}
logging buffered 51200 warnings
!
! SNMP Configuration
snmp-server community NCN-RO RO
snmp-server community NCN-RW RW
!
! Management Gateway
{% if topology.management_gateway is defined %}
ip route 0.0.0.0 0.0.0.0 {{ topology.management_gateway }}
{% endif %}
!
ip ssh version 2
!
! Timezone
clock timezone KST 9 0
!
! Banner
banner motd ^
*** National Converged Network - PE Router {{ node.name }} ***
*** Authorized Access Only - All activities are monitored ***
^
!
mpls ldp router-id Loopback0 force
!
control-plane
!
line con 0
line aux 0
line vty 0 4
 login local
 transport input ssh
!
no scheduler allocate
!
end
