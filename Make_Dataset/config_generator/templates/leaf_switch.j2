{# leaf_switch.j2 #}
!
! Config Generated by GIA Config Generator
! Topology: {{ topology.description }}
! Role: Leaf (CE/Access) Switch
!
version 15.7
service timestamps debug datetime msec
service timestamps log datetime msec
no service password-encryption
!
hostname {{ node.name }}
!
boot-start-marker
boot-end-marker
!
no aaa new-model
!
mmi polling-interval 60
no mmi auto-configure
no mmi pvc
mmi snmp-timeout 180
!
no ip domain lookup
ip domain name ncn.go.kr
ip cef
no ipv6 cef
!
multilink bundle-name authenticated
!
username admin privilege 15 secret 5 $1$Q7C9$Otrsj2ApS12nJyC5G0yeR1
!
redundancy
!
{% for intf in node.interfaces %}
interface {{ intf.name }}
 ip address {{ intf.ip | ip_address }} {{ intf.ip | netmask }}
 duplex auto
 speed auto
 media-type rj45
!
{% endfor %}
!
! Management Interface (OOB)
interface GigabitEthernet0/{{ topology.management_intf_slot | default(7) }}
 ip address {{ node.management_ip | ip_address }} {{ node.management_ip | netmask }}
 duplex auto
 speed auto
 media-type rj45
!
ip forward-protocol nd
!
no ip http server
no ip http secure-server
!
! NTP Configuration
ntp server {{ topology.management_gateway }}
!
! Syslog Configuration
logging host {{ topology.management_gateway }}
logging buffered 4096 informational
!
! Default route to PE (Data Plane)
{% set uplink = node.interfaces[0] %}
{% if uplink.peer_ip is defined %}
ip route 0.0.0.0 0.0.0.0 {{ uplink.peer_ip }}
{% else %}
! Note: Data plane default route to PE should be added manually
{% endif %}
!
! Management Gateway (Control Plane)
{% if topology.management_gateway is defined %}
ip route 10.10.10.0 255.255.255.0 {{ topology.management_gateway }}
! Important: If VRF is not used for Management, default route overlap might occur.
! Ideally, Mgmt should be in vrf Mgmt-intf, but PNETLab basic images might not support Mgmt VRF easily.
! Assuming Management Gateway is preferred for 0.0.0.0 if OOB access is priority,
! BUT Leaf also needs to reach other internal subnets.
! Strategy: Specific route for Mgmt subnet or accept 2 default routes with metrics.
! For simplicity here: Just adding the route.
ip route 0.0.0.0 0.0.0.0 {{ topology.management_gateway }} 250
{% endif %}
!
ip ssh version 2
!
! Timezone
clock timezone KST 9 0
!
control-plane
!
line con 0
line aux 0
line vty 0 4
 login local
 transport input ssh
!
no scheduler allocate
!
end
