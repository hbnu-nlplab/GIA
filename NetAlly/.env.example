# ======================================
# NetAlly 환경변수 예시 (.env로 복사해서 사용)
# ======================================

# --------------------------------------
# 0) 공통/기본
# --------------------------------------
# OpenAI 기반 채팅/도구 실행 시 필수
OPENAI_API_KEY=
# FastAPI 서비스 포트
PORT=8000
# 런타임 설정 저장 파일 경로(상대경로는 NetAlly 기준)
NETALLY_RUNTIME_SETTINGS_PATH=.runtime/settings.runtime.json
# 캐시 디렉터리(선택)
NETALLY_CACHE_DIR=.tmp/cache
# PNETLab 아이콘 루트 경로(선택)
PNETLAB_ICON_ROOT=/opt/unetlab/html/images/icons

# --------------------------------------
# 1) NSO 연결
# --------------------------------------
# 권장: NetAlly 컨테이너에서 도달 가능한 NSO RESTCONF URL
NSO_BASE_URL=http://10.10.10.100:8080/restconf
NSO_USERNAME=admin
NSO_PASSWORD=admin

# 하위호환 별칭(구형 플로우에서 사용 가능, 보통 비워둠)
NSO_USER=
NSO_PASS=

# NSO 자동탐색/URL 조합용(주로 NSO_BASE_URL 비웠을 때 사용)
PNETLAB_NSO_NODE=NSO
NSO_SCHEME=http
NSO_PORT=8080
NSO_RESTCONF_PATH=/restconf

# NSO 등록(onboarding) 기본값
NSO_AUTHGROUP=default
# 예: cisco-ios-cli-6.110 (미지정 시 자동/기본 로직 사용)
NSO_NED_ID=

# --------------------------------------
# 2) PNETLab 인벤토리/인증
# --------------------------------------
# 권장: labfs_local (PNETLab VM 내부 Docker 실행 시)
# 선택: labfs_ssh, api
PNETLAB_INVENTORY_BACKEND=labfs_local

# 대상 Lab 지정(보통 LAB_NAME만 사용)
PNETLAB_LAB_NAME=test_nso
PNETLAB_LAB_PATH=

# PNETLab 호스트 파일시스템 루트
PNETLAB_UNETLAB_ROOT=/opt/unetlab

# PNETLab 웹/API 주소
PNETLAB_URL=http://192.168.50.60
# 하위호환 별칭(보통 비워둠)
PNETLAB_HOST=

# API 인증 방식(auto-login 또는 쿠키/JWT 계열 중 필요한 것만 사용)
PNETLAB_AUTO_LOGIN=false
PNETLAB_USERNAME=admin
PNETLAB_PASSWORD=pnetlab
PNETLAB_COOKIES=
PNETLAB_JWT_TOKEN=
PNETLAB_SESSION=
PNETLAB_XSRF_TOKEN=

# 노드 필터(콤마 구분)
PNETLAB_INCLUDE_NODE_NAMES=
PNETLAB_EXCLUDE_NODE_NAMES=NSO,Docker,NetAlly,Admin
PNETLAB_EXCLUDE_TEMPLATES=

# labfs_ssh 모드 전용(backend=labfs_ssh일 때만 필요)
PNETLAB_SSH_HOST=
PNETLAB_SSH_USER=root
PNETLAB_SSH_PORT=22
PNETLAB_SSH_KEY_PATH=
PNETLAB_SSH_OPTIONS=

# --------------------------------------
# 3) Onboarding 기본값(device_info 생성/등록 시 사용)
# --------------------------------------
PNETLAB_DEVICE_INFO=Data/Pnetlab/Research_Institute_Internal_DC/device_info.json
PNETLAB_DEVICE_INFO_AUTOGEN=true

# 장비 초기화/등록 템플릿 관련(필요 시만 설정)
PNETLAB_VM_IP=
PNETLAB_GATEWAY_IP=
PNETLAB_DOMAIN_NAME=lab.local
PNETLAB_ADMIN_PASSWORD=admin
PNETLAB_ENABLE_PASSWORD=
PNETLAB_OOB_INTF=
PNETLAB_DEVICE_GROUP=

# --------------------------------------
# 4) Batfish
# --------------------------------------
# host:port 형식 허용
BATFISH_HOST=host.docker.internal:9997
# 스냅샷 이름
BATFISH_SNAPSHOT=test_nso
# 하위호환 키(일반적으로 BATFISH_SNAPSHOT과 동일하게 둠)
BATFISH_NETWORK=test_nso
# export 경로
BATFISH_EXPORT_DIR=./snapshot

# 채팅/Prepare에서 Batfish 자동 준비 동작
AUTO_PREPARE_ON_CHAT=false
AUTO_INIT_BATFISH=true

# --------------------------------------
# 5) NetAlly 런타임 백엔드
# --------------------------------------
# mcp 또는 local
NETALLY_TOOL_BACKEND=mcp
# single_executor 또는 team_multi
NETALLY_AGENT_BACKEND=single_executor

# MCP 서버 및 mutation 허용 여부
NETALLY_MCP_SERVER_URL=http://127.0.0.1:8811/mcp
NETALLY_MCP_ALLOW_MUTATIONS=true

# 실행 프롬프트/팀 멀티에이전트 설정(선택)
NETALLY_EXECUTOR_SYSTEM_PROMPT=
NETALLY_TEAM_MULTI_MODULE=agents.main_netconfig
NETALLY_TEAM_MULTI_DATASET_TYPE=netconfig
NETALLY_TEAM_MULTI_ROOT=
NETALLY_TEAM_MULTI_CONTEXT=
NETALLY_TEAM_MULTI_CONTEXT_PATH=

# --------------------------------------
# 6) LLM 공급자(선택)
# --------------------------------------
# openai / vllm / ollama 등 구성 시 사용
NETALLY_EXECUTOR_LLM_BACKEND=openai
NETALLY_EXECUTOR_LLM_MODEL=gpt-4o-mini
VLLM_BASE_URL=http://localhost:8000/v1
OLLAMA_API_URL=http://localhost:11434
