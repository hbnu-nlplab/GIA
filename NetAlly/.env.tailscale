# ======================================
# NetAlly 환경변수 — Tailscale 분산 구성
# ======================================
# Windows WSL(개발) + PNETLab VM(Tailscale) + Ubuntu(vLLM)
#
# 사용법:
#   cp .env.tailscale .env
#   아래 CHANGE_ME 부분을 실제 Tailscale IP로 교체
# ======================================

# ── Tailscale IP 설정 (한 곳에서 관리) ──
# PNETLab VM의 Tailscale IP (tailscale ip -4 로 확인)
PNETLAB_TAILSCALE_IP=CHANGE_ME_PNETLAB_IP
# Ubuntu PC의 Tailscale IP (병렬 vLLM 평가용, 선택)
UBUNTU_TAILSCALE_IP=CHANGE_ME_UBUNTU_IP

# --------------------------------------
# 0) 공통/기본
# --------------------------------------
OPENAI_API_KEY=
PORT=8111
NETALLY_RUNTIME_SETTINGS_PATH=.runtime/settings.runtime.json
NETALLY_CACHE_DIR=.tmp/cache

# --------------------------------------
# 1) NSO 연결 — PNETLab VM 내부 Docker
# --------------------------------------
# NSO는 PNETLab VM에서 Docker로 실행, Tailscale IP로 접근
NSO_BASE_URL=http://${PNETLAB_TAILSCALE_IP}:8080/restconf
NSO_USERNAME=admin
NSO_PASSWORD=admin
NSO_AUTHGROUP=default

# --------------------------------------
# 2) PNETLab 인벤토리 — SSH(LabFS) 모드
# --------------------------------------
# labfs_ssh: WSL에서 PNETLab VM으로 SSH 접속하여 .unl 파싱
PNETLAB_INVENTORY_BACKEND=labfs_ssh

PNETLAB_LAB_NAME=Research_Institute_Internal_DC
PNETLAB_UNETLAB_ROOT=/opt/unetlab

# PNETLab 웹 API (토폴로지 조회, 노드 상태 등)
PNETLAB_URL=http://${PNETLAB_TAILSCALE_IP}

# SSH 접속 설정 (Tailscale IP 직접 사용)
PNETLAB_SSH_HOST=${PNETLAB_TAILSCALE_IP}
PNETLAB_SSH_USER=root
PNETLAB_SSH_PORT=22
PNETLAB_SSH_KEY_PATH=~/.ssh/id_rsa

# 장비 텔넷 콘솔 접속 시 사용할 IP (= PNETLab VM IP)
PNETLAB_VM_IP=${PNETLAB_TAILSCALE_IP}

# 노드 필터
PNETLAB_EXCLUDE_NODE_NAMES=NSO,Docker,NetAlly,Admin

# Onboarding 기본값
PNETLAB_GATEWAY_IP=10.10.10.1
PNETLAB_DOMAIN_NAME=ncn.go.kr
PNETLAB_ADMIN_PASSWORD=admin
PNETLAB_DEVICE_INFO_AUTOGEN=true

# --------------------------------------
# 3) Batfish — WSL 로컬 Docker
# --------------------------------------
# Batfish는 .cfg 파일만 분석, 장비접근 불필요 → 로컬이 최적
BATFISH_HOST=localhost:9997
BATFISH_SNAPSHOT=Research_Institute_Internal_DC
BATFISH_NETWORK=Research_Institute_Internal_DC
BATFISH_EXPORT_DIR=./snapshot
AUTO_INIT_BATFISH=true
AUTO_PREPARE_ON_CHAT=false

# --------------------------------------
# 4) NetAlly 런타임
# --------------------------------------
NETALLY_TOOL_BACKEND=mcp
NETALLY_AGENT_BACKEND=single_executor
NETALLY_MCP_SERVER_URL=http://127.0.0.1:8811/mcp
NETALLY_MCP_ALLOW_MUTATIONS=true

# --------------------------------------
# 5) LLM 공급자 — vLLM (WSL 로컬 RTX 3090)
# --------------------------------------
# 로컬 vLLM 사용 시:
NETALLY_EXECUTOR_LLM_BACKEND=vllm
NETALLY_EXECUTOR_LLM_MODEL=gpt-oss-20b
VLLM_BASE_URL=http://localhost:8000/v1

# Ubuntu vLLM 서버 사용 시 (아래 주석 해제):
# VLLM_BASE_URL=http://${UBUNTU_TAILSCALE_IP}:8000/v1

# OpenAI API 사용 시 (아래 주석 해제):
# NETALLY_EXECUTOR_LLM_BACKEND=openai
# NETALLY_EXECUTOR_LLM_MODEL=gpt-4o-mini

# Ollama (비사용, 참고용)
OLLAMA_API_URL=http://localhost:11434
