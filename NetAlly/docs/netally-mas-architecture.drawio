        <mxCell id="single_exec" value="Single Executor Runtime&#xa;단일 LLM + MCP Tools&#xa;&#xa;실험 E2: Single + Tools" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontStyle=0;fontSize=11;verticalAlign=middle;" vertex="1" parent="1">
