  <diagram id="page3" name="Fig.3 MCP Tool Catalog">
    <mxGraphModel adaptiveColors="auto" dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="750">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="t3" value="MCP Tool Catalog (18 tools) - Collector가 자율 선택하는 도구 목록" style="text;html=0;align=center;verticalAlign=middle;fontStyle=1;fontSize=15;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="150" y="10" width="700" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="nso_area" value="" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;opacity=20;" vertex="1" parent="1">
          <mxGeometry x="30" y="60" width="1040" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="nso_lbl" value="NSO RESTCONF Tools (5) - 장비 설정 조회 via RESTCONF API" style="text;html=0;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;fillColor=#F8CECC;strokeColor=#B85450;rounded=1;spacingLeft=8;spacingRight=8;fontColor=#B85450;" vertex="1" parent="1">
          <mxGeometry x="50" y="48" width="430" height="28" as="geometry"/>
        </mxCell>

        <mxCell id="n1" value="nso_get_device_info(device)&#xa;단일 장비 config 요약&#xa;hostname, aaa, vrf, routing...&#xa;L1 단일 조회" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#B85450;fontSize=9;align=left;spacingLeft=6;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="50" y="85" width="195" height="70" as="geometry"/>
        </mxCell>
