        <mxCell id="nso_tool" value="NSO RESTCONF (5 tools)&#xa;장비 설정 조회&#xa;config_summary + aggregations&#xa;세션 내 캐싱" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F8CECC;strokeColor=#B85450;fontSize=10;verticalAlign=middle;" vertex="1" parent="1">
