        <mxCell id="tool_label" value="MCP Tool Layer (18 tools via tool_dispatch)" style="text;html=0;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;fillColor=#FFF2CC;strokeColor=#D6B656;rounded=1;spacingLeft=8;spacingRight=8;fontColor=#7D6608;" vertex="1" parent="1">
          <mxGeometry x="100" y="318" width="340" height="28" as="geometry"/>
