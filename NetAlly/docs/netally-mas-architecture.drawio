        </mxCell>
        <mxCell id="pnet_tool" value="PNETLab (LabFS)&#xa;토폴로지 조회&#xa;인벤토리 / 상태" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;verticalAlign=middle;" vertex="1" parent="1">
