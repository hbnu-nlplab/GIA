  <diagram id="page2" name="Fig.2 MAS Agent Architecture">
    <mxGraphModel adaptiveColors="auto" dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="t2" value="Fig. 2. Multi-Agent Debate Architecture with MCP Tool Integration" style="text;html=0;align=center;verticalAlign=middle;fontStyle=1;fontSize=15;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="150" y="10" width="700" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="inp2" value="Question (사용자 질문)&#xa;+ level + answer_type + tool_catalog" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F5F5F5;strokeColor=#666666;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="50" width="250" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="p1_area" value="" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;opacity=25;" vertex="1" parent="1">
          <mxGeometry x="20" y="130" width="1060" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="p1_lbl" value="PHASE 1: Evidence Extraction (근거 수집 및 초기 추론)" style="text;html=0;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;rounded=1;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="118" width="400" height="28" as="geometry"/>
        </mxCell>

        <mxCell id="c2" value="A1. Collector (Model B)&#xa;근거 수집기 - MCP 도구 호출&#xa;&#xa;1. LLM이 tool_catalog 분석&#xa;2. JSON 도구 호출 계획 생성&#xa;3. tool_dispatch 순차 실행&#xa;4. 결과를 raw_data로 포맷" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=10;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="155" width="250" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="td2" value="tool_dispatch&#xa;NSO(5) + Batfish(13)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=9;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="315" width="170" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="v2" value="A2. Verifier (Model A)&#xa;검증 필터 - 노이즈 제거&#xa;&#xa;도구 결과 → BYPASS&#xa;Static context → LLM 필터&#xa;L3/L4/L5 → BYPASS" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=10;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="380" y="155" width="230" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="s2" value="A3. Synthesizer (Model A)&#xa;답변 생성기 - 포맷 적용&#xa;&#xa;answer_type별 출력:&#xa; set → [&quot;PE1&quot;, ...]&#xa; path → PE1 → P2 → P3&#xa; number → 단일 정수&#xa; bool → true / false" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=10;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="710" y="150" width="240" height="155" as="geometry"/>
        </mxCell>

        <mxCell id="p2_area" value="" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;opacity=25;" vertex="1" parent="1">
          <mxGeometry x="130" y="400" width="700" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="p2_lbl" value="PHASE 2: Adversarial Debate (적대적 토론 - 답변 검증)" style="text;html=0;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;fillColor=#FFE6CC;strokeColor=#D79B00;rounded=1;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="150" y="388" width="400" height="28" as="geometry"/>
        </mxCell>

        <mxCell id="sup2" value="A4. Supporter (Model A)&#xa;답변 옹호자&#xa;&#xa;DEFEND: 근거 제시 → Critic&#xa;CONCEDE: 오류 인정 → 재합성" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=10;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="150" y="430" width="240" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="db2" value="Debate&#xa;토론" style="ellipse;whiteSpace=wrap;html=0;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontStyle=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="420" y="458" width="65" height="55" as="geometry"/>
        </mxCell>

        <mxCell id="skp2" value="A5. Critic (Model B)&#xa;비판적 검토자&#xa;&#xa;ACCEPT: 답변 확정&#xa;CONTINUE: 재토론 (inner loop)&#xa;NEED_MORE_INFO: 정보 부족&#xa;  → Collector 추가 도구 호출 지시" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;fontSize=10;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="520" y="420" width="280" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="fa2" value="Final&#xa;Answer&#xa;최종 답변" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#60A917;strokeColor=#2D7600;fontColor=#FFFFFF;fontStyle=1;fontSize=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="880" y="455" width="100" height="65" as="geometry"/>
        </mxCell>

        <mxCell id="fb2" value="Targeted Feedback Payload (도구 재호출 지시)&#xa;e.g. &quot;nso_get_routing(PE1, ospf)&quot; / &quot;batfish_link_failure(p1, p2)&quot;" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFF2CC;strokeColor=#D6B656;dashed=1;dashPattern=8 4;fontSize=10;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="200" y="650" width="470" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="ci2" value="inner_turn_count &lt;= 2 (재토론 최대 2회)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=9;fontStyle=1;arcSize=50;" vertex="1" parent="1">
          <mxGeometry x="520" y="610" width="260" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="co2" value="outer_loop_count &lt;= 2 (도구 재호출 최대 2회)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F8CECC;strokeColor=#B85450;fontSize=9;fontStyle=1;arcSize=50;" vertex="1" parent="1">
          <mxGeometry x="30" y="730" width="280" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="cs2" value="recursion_limit = 60 (무한루프 방지)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F5F5F5;strokeColor=#666666;fontSize=9;fontStyle=1;arcSize=50;" vertex="1" parent="1">
          <mxGeometry x="700" y="730" width="240" height="22" as="geometry"/>
        </mxCell>

        <mxCell id="note2" value="핵심: Collector는 프롬프트 기반으로 18개 도구를 자율 선택.&#xa;L5 What-If 질문에서 여러 도구 조합 호출 가능.&#xa;agents_v3(원본)와 동일한 5-Agent 구조, 차이는 MCP 도구 호출." style="shape=note;whiteSpace=wrap;html=0;size=14;align=left;spacingLeft=8;fillColor=#FFFFCC;strokeColor=#999999;fontSize=9;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="650" width="330" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="e2_1" edge="1" parent="1" source="inp2" target="c2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2_2" value="Context (raw_data)" edge="1" parent="1" source="c2" target="v2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2_3" value="Passage (검증된 정보)" edge="1" parent="1" source="v2" target="s2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2_4" value="candidate answer" edge="1" parent="1" source="s2" target="sup2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2_5" edge="1" parent="1" source="sup2" target="db2" style="rounded=1;strokeWidth=1.5;dashed=1;dashPattern=5 3;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2_6" edge="1" parent="1" source="db2" target="skp2" style="rounded=1;strokeWidth=1.5;dashed=1;dashPattern=5 3;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2_7" value="ACCEPT" edge="1" parent="1" source="skp2" target="fa2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=3;strokeColor=#2D7600;fontColor=#2D7600;fontStyle=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2_8" value="CONTINUE (재토론)" edge="1" parent="1" source="skp2" target="sup2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=1.5;dashed=1;dashPattern=6 3;exitX=0;exitY=0.85;exitDx=0;exitDy=0;entryX=1;entryY=0.85;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2_9" value="CONCEDE (재합성)" edge="1" parent="1" source="sup2" target="s2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=1.5;strokeColor=#6C8EBF;fontColor=#6C8EBF;dashed=1;dashPattern=6 3;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2_10" value="NEED_MORE_INFO" edge="1" parent="1" source="skp2" target="fb2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#B85450;fontColor=#B85450;fontStyle=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2_11" value="outer loop (도구 재호출)" edge="1" parent="1" source="fb2" target="c2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=3;strokeColor=#B85450;fontColor=#B85450;fontStyle=1;dashed=1;dashPattern=10 5;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=1;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="20" y="675"/>
              <mxPoint x="20" y="295"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e2_12" edge="1" parent="1" source="c2" target="td2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=1.5;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
